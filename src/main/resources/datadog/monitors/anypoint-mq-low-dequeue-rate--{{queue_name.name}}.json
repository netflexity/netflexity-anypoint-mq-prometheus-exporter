{
  "id": 267847863,
  "type": "metric alert",
  "name": "[Anypoint MQ] Low Dequeue Rate - {{queue_name.name}}",
  "message": "Queue {{queue_name.name}} in environment {{environment.name}} has a dequeue rate of {{value}}%.\n\nThis means consumers are falling behind producers. Check consumer health and processing capacity.\n\n@slack-alerts",
  "tags": [
    "service:anypoint-mq",
    "monitor:dequeue-rate"
  ],
  "query": "avg(last_10m):avg:anypoint_mq.anypoint_mq_queue_dequeue_rate_percent{*} by {queue_name} < 50",
  "options": {
    "thresholds": {
      "critical": 50.0,
      "warning": 75.0
    },
    "notify_no_data": false,
    "renotify_interval": 30,
    "evaluation_delay": 60,
    "notify_audit": false,
    "new_host_delay": 300,
    "include_tags": true,
    "silenced": {}
  },
