{
  "id": 267848011,
  "type": "metric alert",
  "name": "[Anypoint MQ] Stale Messages Detected - {{queue_name.name}}",
  "message": "Queue {{queue_name.name}} has {{value}} stale messages stuck across multiple polling cycles.\n\nCheck for poison messages, consumer errors, or DLQ issues.\n\n@slack-alerts",
  "tags": [
    "service:anypoint-mq",
    "monitor:stale-messages"
  ],
  "query": "avg(last_10m):avg:anypoint_mq.anypoint_mq_queue_stale_messages{*} by {queue_name} > 0",
  "options": {
    "thresholds": {
      "critical": 0.0
    },
    "notify_no_data": false,
    "renotify_interval": 60,
    "evaluation_delay": 60,
    "notify_audit": false,
    "new_host_delay": 300,
    "include_tags": true,
    "silenced": {}
  },
