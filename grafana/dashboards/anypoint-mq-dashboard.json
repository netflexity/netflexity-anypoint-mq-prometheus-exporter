      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "id": 201,
      "alert": {
        "name": "Dead Letter Queue Growth",
        "conditions": [
          {
            "evaluator": {
              "params": [
                0
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "last"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "for": "5m",
        "frequency": "1m",
        "noDataState": "no_data",
        "notifications": [],
        "message": "Dead letter queue {{ $labels.queue_name }} in {{ $labels.environment }} has {{ $value }} messages. Failed messages need immediate investigation.",
        "alertRuleTags": {
          "severity": "critical"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
