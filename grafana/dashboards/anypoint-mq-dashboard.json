    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Fires when any dead letter queue has messages sitting in it for more than 5 minutes. Indicates failed message processing that needs investigation.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": true,
