{
  "title": "Anypoint MQ \u2014 Queue & Exchange Monitoring",
  "description": "Real-time monitoring of MuleSoft Anypoint MQ queues and exchanges.\nPowered by the Netflexity Anypoint MQ Prometheus Exporter.\nhttps://github.com/netflexity/netflexity-anypoint-mq-prometheus-exporter",
  "widgets": [
    {
      "id": 100,
      "definition": {
        "type": "group",
        "title": "Overview",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Total Queues",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "count_not_null(avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region} by {queue_name})",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Total Messages Queued",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 2,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "In Flight",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_in_flight{$environment,$region}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0,
              "custom_unit": "msg"
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "DLQ Messages",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1 + query2"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_in_queue{queue_name:*dlq*,$environment,$region}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_in_queue{queue_name:*dead*,$environment,$region}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": "<=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Environments",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "count_not_null(avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$region} by {environment})",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "definition": {
              "title": "Exchanges",
              "title_size": "16",
              "title_align": "center",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "count_not_null(avg:anypoint_mq.anypoint_mq_exchange_messages_published{$environment,$region} by {exchange_name})",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 10,
              "y": 0,
              "width": 2,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 200,
      "definition": {
        "type": "group",
        "title": "Queue Depth & Backlog",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Messages In Queue (Top 10)",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "top(avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region} by {queue_name}, 10, 'last', 'desc')"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "yaxis": {
                "include_zero": true,
                "min": "0"
              },
              "markers": [
                {
                  "value": "y = 1000",
                  "display_type": "warning dashed",
                  "label": "Warning (1K)"
                },
                {
                  "value": "y = 10000",
                  "display_type": "error dashed",
                  "label": "Critical (10K)"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "Queue Depth Distribution",
              "type": "toplist",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "limit": {
                        "count": 20,
                        "order": "desc"
                      }
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region} by {queue_name}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 4
            }
          },
          {
            "definition": {
              "title": "Messages In Flight",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_flight{$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ],
              "yaxis": {
                "include_zero": true,
                "min": "0"
              }
            },
            "layout": {
              "x": 0,
              "y": 4,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Queue Backlog Change (1h)",
              "type": "change",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region} by {queue_name}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "change_type": "absolute",
                  "compare_to": "hour_before",
                  "order_by": "change",
                  "order_dir": "desc"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 4,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 8
      }
    },
    {
      "id": 300,
      "definition": {
        "type": "group",
        "title": "Throughput",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Messages Sent (Published)",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_sent{$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "cool"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Messages Received (Consumed)",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_received{$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "purple"
                  }
                }
              ]
            },
            "layout": {
              "x": 4,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Messages Acknowledged",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_acked{$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "green"
                  }
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Processing Rate \u2014 Sent vs Acked",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Sent"
                    },
                    {
                      "formula": "query2",
                      "alias": "Acknowledged"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_sent{$environment,$region,$queue}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_acked{$environment,$region,$queue}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "thick"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Unacknowledged Gap (Sent - Acked)",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1 - query2",
                      "alias": "Unacked"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_sent{$environment,$region} by {queue_name}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:anypoint_mq.anypoint_mq_queue_messages_acked{$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "area",
                  "style": {
                    "palette": "orange"
                  }
                }
              ],
              "yaxis": {
                "include_zero": true,
                "min": "0"
              }
            },
            "layout": {
              "x": 6,
              "y": 3,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 12,
        "height": 7
      }
    },
    {
      "id": 400,
      "definition": {
        "type": "group",
        "title": "Dead Letter Queues",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "DLQ \u2014 Messages Over Time",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "DLQ (*-dlq)"
                    },
                    {
                      "formula": "query2",
                      "alias": "DLQ (*dead*)"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{queue_name:*dlq*,$environment,$region} by {queue_name}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{queue_name:*dead*,$environment,$region} by {queue_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "style": {
                    "palette": "red"
                  }
                }
              ],
              "yaxis": {
                "include_zero": true,
                "min": "0"
              }
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "DLQ Breakdown",
              "type": "toplist",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "limit": {
                        "count": 10,
                        "order": "desc"
                      }
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{queue_name:*dlq* OR queue_name:*dead*,$environment,$region} by {queue_name}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 0,
                      "palette": "white_on_red"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 8,
              "y": 0,
              "width": 4,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 18,
        "width": 12,
        "height": 4
      }
    },
    {
      "id": 500,
      "definition": {
        "type": "group",
        "title": "Exchanges",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Messages Published to Exchanges",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_exchange_messages_published{$environment,$region} by {exchange_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "cool"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Messages Delivered from Exchanges",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_exchange_messages_delivered{$environment,$region} by {exchange_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "definition": {
              "title": "Exchange Fan-out Ratio (Delivered / Published)",
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query2 / query1",
                      "alias": "Fan-out Ratio"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_exchange_messages_published{$environment,$region} by {exchange_name}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:anypoint_mq.anypoint_mq_exchange_messages_delivered{$environment,$region} by {exchange_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line",
                  "style": {
                    "palette": "green",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "yaxis": {
                "include_zero": true,
                "min": "0"
              }
            },
            "layout": {
              "x": 0,
              "y": 3,
              "width": 12,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 22,
        "width": 12,
        "height": 7
      }
    },
    {
      "id": 600,
      "definition": {
        "type": "group",
        "title": "Queue Inventory",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "All Queues \u2014 Current State",
              "type": "query_table",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "In Queue",
                      "conditional_formats": [
                        {
                          "comparator": ">",
                          "value": 10000,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">",
                          "value": 1000,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": "<=",
                          "value": 1000,
                          "palette": "white_on_green"
                        }
                      ]
                    },
                    {
                      "formula": "query2",
                      "alias": "In Flight"
                    },
                    {
                      "formula": "query3",
                      "alias": "Sent"
                    },
                    {
                      "formula": "query4",
                      "alias": "Received"
                    },
                    {
                      "formula": "query5",
                      "alias": "Acked"
                    },
                    {
                      "formula": "query3 - query5",
                      "alias": "Unacked"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_queue{$environment,$region} by {queue_name,environment}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_in_flight{$environment,$region} by {queue_name,environment}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query3",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_sent{$environment,$region} by {queue_name,environment}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query4",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_received{$environment,$region} by {queue_name,environment}",
                      "aggregator": "last"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query5",
                      "query": "avg:anypoint_mq.anypoint_mq_queue_messages_acked{$environment,$region} by {queue_name,environment}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "has_search_bar": "auto"
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 5
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 29,
        "width": 12,
        "height": 6
      }
    },
    {
      "id": 700,
      "definition": {
        "type": "group",
        "title": "Monitors (Pro)",
        "show_title": true,
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Monitor Evaluations",
              "type": "query_value",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:anypoint_mq.anypoint_mq_monitor_evaluations_total{$environment}",
                      "aggregator": "last"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "autoscale": true,
              "precision": 0
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
